% az, azure, cloud, cli, subscription, resource, keyvault, storage, login

; Written for azure-cli 2.92. Every command takes:
;   -o table|tsv|json|jsonc|yaml   output format
;   --query '<jmespath>'           filter the output (JMESPath, not jq)
;   --subscription <name|id>       run against another subscription for one command
;   --only-show-errors             hide warnings
; Add --help to any group or command, e.g. az storage blob --help.

# Log in (browser)
az login

# Log in with a device code (headless box, WSL without a browser)
az login --use-device-code

# Log in to a specific tenant
az login --tenant <tenant>

# Show the signed-in user and current subscription
az account show --query '{user:user.name, subscription:name, subId:id, tenant:tenantId}' -o jsonc

# List subscriptions
az account list --query '[].{name:name, subId:id, default:isDefault}' -o table

# Switch subscription
az account set --subscription "<subscription>"

# Pick a subscription with fzf and switch to it
az account set --subscription "$(az account list --query '[].name' -o tsv | fzf)"

# Refresh the subscription list (after being given access to a new one)
az account list --refresh -o table

# Print the current subscription id
az account show --query id -o tsv

# Get an access token for a resource (e.g. https://api.fabric.microsoft.com)
az account get-access-token --resource <resource_url> --query accessToken -o tsv

# Show when the current token expires
az account get-access-token --query expiresOn -o tsv

# List resource groups
az group list --query '[].{name:name, location:location}' -o table

# List resource groups in one location
az group list --query "[?location=='<location>'].name" -o tsv

# List resources in a resource group
az resource list -g <group> --query '[].{name:name, kind:type}' -o table

# List all resources of one type in the subscription
az resource list --resource-type <resource_type> --query '[].{name:name, rg:resourceGroup}' -o table

# Show a resource as JSON by its full id
az resource show --ids <resource_id>

# Create a resource group
az group create --name <new_group> --location <location>

# Delete a resource group and everything in it (no prompt, returns at once)
az group delete --name <group> --yes --no-wait

# Preview what a Bicep/ARM deployment would change
az deployment group what-if -g <group> --template-file <template_file>

# Deploy a Bicep/ARM template to a resource group
az deployment group create -g <group> --template-file <template_file> --parameters <params_file>

# List my role assignments everywhere
az role assignment list --assignee "$(az ad signed-in-user show --query userPrincipalName -o tsv)" --all --query '[].{role:roleDefinitionName, scope:scope}' -o table

# Find a service principal / app registration by name
az ad sp list --display-name '<name>' --query '[].{name:displayName, appId:appId}' -o table

# List Key Vaults
az keyvault list --query '[].{name:name, rg:resourceGroup}' -o table

# List secret names in a Key Vault
az keyvault secret list --vault-name <vault> --query '[].name' -o tsv

# Print a secret value
az keyvault secret show --vault-name <vault> --name <secret> --query value -o tsv

# Set a secret without it ending up in shell history
read -rsp 'Secret value: ' v && az keyvault secret set --vault-name <vault> --name <secret> --value "$v" --query id -o tsv; unset v

# List storage accounts
az storage account list --query '[].{name:name, rg:resourceGroup, sku:sku.name}' -o table

# List containers in a storage account (uses your Entra login, not keys)
az storage container list --account-name <storage_account> --auth-mode login --query '[].name' -o tsv

# List blobs in a container, optionally under a prefix
az storage blob list --account-name <storage_account> -c <container> --prefix '<prefix>' --auth-mode login --query '[].{name:name, size:properties.contentLength, modified:properties.lastModified}' -o table

# Download a blob
az storage blob download --account-name <storage_account> -c <container> --name <blob> --file <file> --auth-mode login

# Upload a file as a blob (overwrite if it exists)
az storage blob upload --account-name <storage_account> -c <container> --name <blob> --file <file> --overwrite --auth-mode login

# List VMs with their power state
az vm list -d --query '[].{name:name, rg:resourceGroup, state:powerState}' -o table

# Start a VM
az vm start -g <group> -n <vm>

# Stop and deallocate a VM (stops billing for compute)
az vm deallocate -g <group> -n <vm>

# List function apps
az functionapp list --query '[].{name:name, rg:resourceGroup, state:state}' -o table

# Stream a web app's / function app's logs
az webapp log tail -g <group> -n <app>

# Get AKS credentials into ~/.kube/config
az aks get-credentials -g <group> -n <aks>

# Log in to a container registry (for docker push/pull)
az acr login --name <acr>

# Call any Azure REST API (auth is handled; {subscriptionId} is filled in)
az rest --method get --url "https://management.azure.com/subscriptions/{subscriptionId}/resourcegroups?api-version=2021-04-01" --query 'value[].name' -o tsv

# Run a KQL query against a Log Analytics workspace (needs the log-analytics extension)
az monitor log-analytics query --workspace <workspace_id> --analytics-query '<kql>' -o table

# Set a default resource group / location for later commands
az config set defaults.group=<group> defaults.location=<location>

# Show the CLI config
az config get

# List installed extensions
az extension list -o table

# Show CLI and extension versions
az version

# Interactive shell with autocompletion
az interactive

; Gotchas
; - -o table leaves out columns named id or type. Rename them in --query:
;   {subId:id, kind:type}.
; - JMESPath string literals use single quotes inside the query: "[?name=='x']".
;   So wrap the whole --query in double quotes when it has a filter.
; - contains(name,'Prod') also matches 'NonProd'. Use name=='...' or starts_with().
; - Commands from an extension (e.g. monitor log-analytics) install the extension on
;   first use, even with just --help. In a script that happens without a prompt. To stop it:
;   az config set extension.use_dynamic_install=no
; - Storage data commands use account keys by default. Add --auth-mode login to use
;   your Entra roles (needs "Storage Blob Data Reader/Contributor", not just Owner).
; - resourceGroup can come back in different case (az vm list says P-WE2BIDL-COM).
;   JMESPath == is case-sensitive, so filter on lower case if needed.
; - az group delete --no-wait returns at once. Check with az group show -n <name>.
; - Config and tokens live in $AZURE_CONFIG_DIR (default ~/.azure).
; - "Unable to check if your CLI is up-to-date" just means no internet / proxy.

$ subscription: az account list --query '[].name' -o tsv 2>/dev/null
$ group: az group list --query '[].name' -o tsv 2>/dev/null
$ location: printf 'westeurope\nnortheurope\nnorwayeast\neastus2\n'
$ resource_type: printf 'Microsoft.KeyVault/vaults\nMicrosoft.Storage/storageAccounts\nMicrosoft.Web/sites\nMicrosoft.Fabric/capacities\nMicrosoft.Compute/virtualMachines\n'
$ resource_id: az resource list --query '[].id' -o tsv 2>/dev/null
$ resource_url: printf 'https://api.fabric.microsoft.com\nhttps://management.azure.com\nhttps://storage.azure.com\nhttps://vault.azure.net\nhttps://graph.microsoft.com\n'
$ vault: az keyvault list --query '[].name' -o tsv 2>/dev/null
$ secret: az keyvault secret list --vault-name <vault> --query '[].name' -o tsv 2>/dev/null
$ storage_account: az storage account list --query '[].name' -o tsv 2>/dev/null
$ container: az storage container list --account-name <storage_account> --auth-mode login --query '[].name' -o tsv 2>/dev/null
$ blob: az storage blob list --account-name <storage_account> -c <container> --auth-mode login --query '[].name' -o tsv 2>/dev/null
$ vm: az vm list -g <group> --query '[].name' -o tsv 2>/dev/null
$ app: az webapp list -g <group> --query '[].name' -o tsv 2>/dev/null
$ aks: az aks list -g <group> --query '[].name' -o tsv 2>/dev/null
$ acr: az acr list --query '[].name' -o tsv 2>/dev/null
$ template_file: ls *.bicep *.json 2>/dev/null
$ params_file: ls *.bicepparam *.parameters.json 2>/dev/null
$ file: ls -p | grep -v /
$ prefix: printf '\n'
